# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
# The TEMPLATE is versioned (the negation wins over .env.*).
!.env.example
# Single-user source-tree secrets (see dourmouse/local_secrets.py).
dourmouse/local_secrets.py
# v14: the product's OWN shared OAuth client (see google_auth.py's own
# comment on _builtin_oauth) — real, working credentials never belong in
# a public repo's history, even though Google's threat model tolerates
# a Desktop-app client secret being non-confidential.
dourmouse/_builtin_oauth.py

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Tool caches ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Runtime state (sessions, memory db, pids) ────────────────────────────
workspace/
data/
*.log
nohup.out
.dourmouse-ui.pid
.jarvis-ui.pid

# ── Rebuildable artifacts ────────────────────────────────────────────────
dourmouse.app/
dist/
build/
*.zip

# ── Downloaded models / caches (fetched on demand) ───────────────────────
voice_models/
whisper_models/
*.onnx

# ── OS junk ──────────────────────────────────────────────────────────────
# AppleDouble sidecar files (exFAT/network drives create these next to
# every file) — a gitignore pattern comment must be on its own line; an
# inline "pattern  # comment" is taken as literal pattern text, not a
# comment, so this was previously silent-broken twice over (also had a
# leading-whitespace typo that made the pattern itself never match).
.DS_Store
._*
sync_log.txt

# v8.30: runtime artifact of dourmouse/global_memory.py's default store
global_memory.sqlite3

# ── Electron shell (dourmouse-recon/electron/ — the desktop-shell
# migration, see ~/.claude/plans/sorted-wiggling-pearl.md) ────────────────
electron/node_modules/
electron/verify-result.json
# Stage E rebuildable build output: the packaged .app/.dmg AND the
# venv-stage prepare-venv.sh builds fresh each time (real credentials/keys
# are never baked into it — see requirements*.txt instead) — same
# "rebuildable artifacts never committed" rule as dourmouse.app/ and dist/
# above, just under electron/'s own build/ output directory.
electron/build/dist/
electron/build/venv-stage/

# ── Large binaries ───────────────────────────────────────────────────────
# lora-dourmouse-claude.gguf and site/downloads/*.exe are intentionally NOT
# listed here — they stay git-tracked (see .gitattributes: the .gguf is
# Git LFS; the installer .exe is a deliberate plain-blob exception because
# an external static-site deploy serves it straight from this repo's
# working tree). Don't add them to this file without re-reading that note
# and README.md "Binary assets & Git LFS" first.
