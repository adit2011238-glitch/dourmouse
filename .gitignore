# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
# The TEMPLATE is versioned (the negation wins over .env.*).
!.env.example
# Single-user source-tree secrets (see dourmouse/local_secrets.py).
dourmouse/local_secrets.py

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Tool caches ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Runtime state (sessions, memory db, pids) ────────────────────────────
workspace/
*.log
nohup.out
.dourmouse-ui.pid
.jarvis-ui.pid

# ── Rebuildable artifacts ────────────────────────────────────────────────
dourmouse.app/
dist/
build/
*.zip

# ── Downloaded models / caches (fetched on demand) ───────────────────────
voice_models/
whisper_models/
*.onnx

# ── OS junk ──────────────────────────────────────────────────────────────
.DS_Store  # AppleDouble sidecar files (exFAT drives create these next to every file)
  ._*
  sync_log.txt
