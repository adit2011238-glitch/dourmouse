# ATLAS Dourmouse — environment configuration template.
# Copy to `.env` and fill in. NEVER commit a real `.env`. Secrets are read from
# here / the environment and are never hardcoded in source (Rule 2.6).

# ---------------------------------------------------------------------------
# Phase 0 — Guardrail risk numbers (currently the confirmed defaults).
# These are the ONLY vars actually consumed by code so far.
# ---------------------------------------------------------------------------
DOURMOUSE_MAX_POSITION_PCT=0.10        # max single-position size as fraction of equity
DOURMOUSE_MAX_SECTOR_PCT=0.30          # max one-sector concentration as fraction of equity
DOURMOUSE_DAILY_LOSS_LIMIT_PCT=0.03    # daily-loss kill-switch, fraction of start-of-day equity
DOURMOUSE_TRADE_CONFIRM_USD=1000       # notional $ at/above which a trade needs human confirmation

# ---------------------------------------------------------------------------
# Phase 1 — Orchestrator LLM backend. NVIDIA NIM (OpenAI-compatible), per
# user decision: "everything run off nvidia, the best nvidia model
# practically usable". Consumed by dourmouse/orchestrator.py.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---------------------------------------------------------------------------
# Phase 1 — ATLAS integration (Research Agent). NOT yet consumed until the
# real ATLAS repo path is provided.
# ---------------------------------------------------------------------------
ATLAS_REPO_PATH=
ATLAS_VENV_PATH=

# ---------------------------------------------------------------------------
# Phase 3+ — Alpaca (paper first). NOT yet consumed by any code.
# ---------------------------------------------------------------------------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------------------
# Phase 2 — Obsidian MCP / vault. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=

# ---------------------------------------------------------------------------
# Phase 3 — Slack front end. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---------------------------------------------------------------------------
# Phase 1 — DigitalOcean host. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
DIGITALOCEAN_HOST=
DIGITALOCEAN_SSH_USER=

# ---------------------------------------------------------------------------
# Claude Code bridge — dev_coding subagent's claude_code tool + the v2.4
# code_claude coding agent. Optional: the tool auto-detects the 'claude' CLI
# on PATH; set this only to point at a specific binary.
# ---------------------------------------------------------------------------
CLAUDE_CODE_CLI=

# ---------------------------------------------------------------------------
# v2.4 — Multi-backend coding agents (code_nvidia / code_deepseek /
# code_claude). code_nvidia reuses NVIDIA_API_KEY above. code_deepseek uses
# the Freebuff free tier when FREEBUFF_DEEPSEEK_* are set, else plain
# DeepSeek, else (v5.1) routes through NVIDIA NIM using NVIDIA_API_KEY with
# DEEPSEEK_NVIDIA_MODEL below — so a single NVIDIA key powers DeepSeek too.
# code_claude uses the Claude Code CLI. All degrade honestly to
# NOT CONFIGURED when nothing is set. Consumed by dourmouse/code_backends.py.
# ---------------------------------------------------------------------------
FREEBUFF_DEEPSEEK_API_KEY=
FREEBUFF_DEEPSEEK_BASE_URL=
FREEBUFF_DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# v3.1 per-agent NVIDIA models (optional): give ONE subagent its own model
# (e.g. a coding-tuned model for dev_coding, a fast model for news). Any
# agent without an override runs on NVIDIA_MODEL above. Names are the roster
# agent names, uppercase: research_info, comms, scheduling, dev_coding,
# admin_ops, memory, system, news, markets, rnd, mail, tasks, messenger,
# code_nvidia, code_deepseek, code_claude, orchestrator.
# DOURMOUSE_MODEL_DEV_CODING=nvidia/code-llama-70b
# DOURMOUSE_MODEL_RESEARCH_INFO=nvidia/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# v4.0 — LOCAL LLM backend (the "fully free and local" win). Ollama is the
# primary brain; NVIDIA stays as a configured alternative. Consumed by
# dourmouse/config.py load_llm_config().
#   DOURMOUSE_LLM_BACKEND=ollama | nvidia | auto
#     auto (default): probe http://127.0.0.1:11434/api/tags — if Ollama is
#     live, use it; otherwise fall back to NVIDIA. Explicit settings skip
#     the probe and fail fast if the backend is unreachable.
# ---------------------------------------------------------------------------
DOURMOUSE_LLM_BACKEND=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b              # chat/reasoning model (installed locally)
# OLLAMA_CODING_MODEL=qwen2.5-coder:14b   # code_ollama uses this when set

# ---------------------------------------------------------------------------
# v4.0 — MULTI-DEVICE (Phase 9). Loopback (127.0.0.1) is always token-free so
# the desktop app and local chat never change; the token is enforced for any
# NON-loopback client. DOURMOUSE_HOST=0.0.0.0 exposes the dashboard to your
# LAN/tailnet — only do this AFTER setting a token. Consumed by
# dourmouse/config.py access_token() / bind_host().
# ---------------------------------------------------------------------------
DOURMOUSE_ACCESS_TOKEN=
DOURMOUSE_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# v4.0 — AUTOMATION (Phase 11). Time (24h, local) at which the DailyReporter
# posts the morning report to the bus. Consumed by dourmouse/report.py.
# ---------------------------------------------------------------------------
DOURMOUSE_REPORT_TIME=08:30

# ---------------------------------------------------------------------------
# v4.1 — VOICE (P7). FULLY local STT + TTS — zero cloud calls.
# Default OFF. Enable, install the optional wheels, then the HUD's [MIC]/[SPK]
# buttons go live. Consumed by dourmouse/voice.py.
#   pip install -r requirements-voice.txt   (faster-whisper + piper-tts)
# TTS works without piper on macOS (built-in 'say', zero deps); STT needs
# faster-whisper. First STT use downloads the model once, then it is local.
# ---------------------------------------------------------------------------
DOURMOUSE_VOICE=0
DOURMOUSE_WHISPER_MODEL=tiny
DOURMOUSE_WHISPER_DEVICE=auto
DOURMOUSE_PIPER_VOICE=en_US-lessac-medium

# ---------------------------------------------------------------------------
# v5.1 — Gmail tools (mail subagent: gmail_search / gmail_read / gmail_send).
# Either set the env vars below, OR — for a single-user install — fill in
# dourmouse/local_secrets.py (GMAIL_USER / GMAIL_APP_PASSWORD). That file is
# GITIGNORED so the credential never lands in git history or the dist zip;
# env vars always win when both are set. Get an App Password from Google
# account -> Security -> 2-Step Verification -> App passwords (NOT your
# login password). Consumed by dourmouse/google_services.py.
# ---------------------------------------------------------------------------
GOOGLE_GMAIL_USER=
GOOGLE_GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# v5.3 — Codex CLI bridge (dev_coding's codex_code tool). Optional: the tool
# auto-detects the 'codex' CLI on PATH and uses the ChatGPT login it already
# has in ~/.codex/auth.json — no API key needed. CODEX_CLI points at a
# specific binary; CODEX_API_KEY powers the code_codex API backend instead.
# ---------------------------------------------------------------------------
CODEX_CLI=
CODEX_API_KEY=

# ---------------------------------------------------------------------------
# v5.3 — Freebuff Desktop integration (check_connections tool + the
# /api/connections endpoint). The app runs a local API (default port 51820)
# that requires a bearer token shown in the Freebuff app; paste it here to
# let Dourmouse read real Freebuff status. Without it, the tool honestly
# reports the app state + "token missing".
# ---------------------------------------------------------------------------
FREEBUFF_API_URL=http://127.0.0.1:51820
FREEBUFF_API_TOKEN=

# ---------------------------------------------------------------------------
# v5.3 — per-agent OLLAMA models (mirror of the NVIDIA DOURMOUSE_MODEL_<AGENT>
# convention). CAUTION: the per-agent override is ALSO the dispatch BRAIN for
# that agent's runs, so it must be tool-calling-capable. Measured live:
# qwen2.5:7b (the default brain) calls tools correctly; qwen2.5-coder:14b
# answers WITHOUT calling any tool. Only override with a model that emits
# tool calls (e.g. qwen3:8b).
# ---------------------------------------------------------------------------
# DOURMOUSE_OLLAMA_MODEL_DEV_CODING=qwen3:8b
