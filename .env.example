# ATLAS Dourmouse — environment configuration template.
# Copy to `.env` and fill in. NEVER commit a real `.env`. Secrets are read from
# here / the environment and are never hardcoded in source (Rule 2.6).

# ---------------------------------------------------------------------------
# Phase 0 — Guardrail risk numbers (currently the confirmed defaults).
# These are the ONLY vars actually consumed by code so far.
# ---------------------------------------------------------------------------
DOURMOUSE_MAX_POSITION_PCT=0.10        # max single-position size as fraction of equity
DOURMOUSE_MAX_SECTOR_PCT=0.30          # max one-sector concentration as fraction of equity
DOURMOUSE_DAILY_LOSS_LIMIT_PCT=0.03    # daily-loss kill-switch, fraction of start-of-day equity
DOURMOUSE_TRADE_CONFIRM_USD=1000       # notional $ at/above which a trade needs human confirmation

# ---------------------------------------------------------------------------
# Phase 1 — Orchestrator LLM backend. NVIDIA NIM (OpenAI-compatible), per
# user decision: "everything run off nvidia, the best nvidia model
# practically usable". Consumed by dourmouse/orchestrator.py.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---------------------------------------------------------------------------
# Phase 1 — ATLAS integration (Research Agent). NOT yet consumed until the
# real ATLAS repo path is provided.
# ---------------------------------------------------------------------------
ATLAS_REPO_PATH=C:\\Users\\ankit\\Documents\\forex-engine
ATLAS_VENV_PATH=

# ---------------------------------------------------------------------------
# v6.0 — forex-data pipeline integration (forex subagent). FOREX_DATA_PATH
# must point at the real research-pipeline root (the tree with market-data/,
# scripts/, reports/). All forex_* tools report honest NOT CONFIGURED until
# this is set. IBKR_* feed the 2s TCP reachability probe (paper gateway).
# Consumed by dourmouse/forex_ops.py.
# ---------------------------------------------------------------------------
FOREX_DATA_PATH=
IBKR_HOST=192.168.1.95
IBKR_PORT=7497

# ---------------------------------------------------------------------------
# v8.0 — ATLAS Terminal (streamlit, atlas_terminal/). Optional: live
# headlines feed (MarketAux). The economic-calendar tab is real data and
# works without a key. Launcher: ./start_atlas_ui.sh
# DOURMOUSE_ATLAS_TERMINAL_PORT sets the port the [ATLAS TERMINAL] HUD
# button opens (default 8511).
# ---------------------------------------------------------------------------
MARKETAUX_API_KEY=
DOURMOUSE_ATLAS_TERMINAL_PORT=8511

# ---------------------------------------------------------------------------
# v8.2 — Trading 212 broker (t212 subagent). Official Public API (beta):
# account summary, positions, portfolio, paper-first order placement.
# Generate the key in the T212 app (Settings -> API (Beta)); switch to
# Practice first for a demo key. T212_ENV=demo is the safe default; live
# needs T212_ALLOW_LIVE=1 as an explicit second gate.
# ---------------------------------------------------------------------------
T212_API_KEY=
T212_ENV=demo

# ---------------------------------------------------------------------------
# v8.3 — MetaTrader 5 paper broker (mt5 subagent). No API key needed: the
# free MT5 terminal must be installed and logged into a DEMO account (real-
# time quotes + simulated fills, no subscriptions, no margin floors).
# Demo = genuine paper. Live accounts are double-gated and OFF by default.
# ---------------------------------------------------------------------------
MT5_ALLOW_LIVE=0
MT5_CONFIRM_LIVE=0

# ---------------------------------------------------------------------------
# v8.4 — TradingView bridge (POST /api/tv-webhook). TradingView has NO
# execution API; its alerts POST a message to a webhook URL. Set a secret
# here and include it in the alert message JSON ({"secret":"...", ...}) —
# TradingView cannot add headers. EMPTY = open webhook (loopback only; do
# not expose a public tunnel without a secret). Signals land in
# workspace/tv_signals.jsonl and drive the seasonal paper log
# (FOREX_DATA_PATH/reports/paper_log.csv).
# ---------------------------------------------------------------------------
# The PUBLIC https URL TradingView alerts POST to (the active cloudflared /
# ngrok tunnel pointing at the standalone tv_webhook_server, port 8766).
# Showed in the HUD panel; changes whenever the quick tunnel restarts.
TV_PUBLIC_URL=
TV_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Phase 3+ — Alpaca (paper first). NOT yet consumed by any code.
# ---------------------------------------------------------------------------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------------------
# Phase 2 — Obsidian MCP / vault. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=

# ---------------------------------------------------------------------------
# Phase 3 — Slack front end. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---------------------------------------------------------------------------
# Phase 1 — DigitalOcean host. NOT yet consumed by any code.
# ---------------------------------------------------------------------------
DIGITALOCEAN_HOST=
DIGITALOCEAN_SSH_USER=

# ---------------------------------------------------------------------------
# Desktop conversion (v5.19) — deep links + secure self-update feed.
# ---------------------------------------------------------------------------
DOURMOUSE_UPDATE_FEED=            # https URL of the signed latest.json update
                                  # feed. Unset = no update channel; /api/version
                                  # honestly reports configured:false.
DOURMOUSE_UPDATE_CHANNEL=stable   # stable | beta (default stable)
DOURMOUSE_APP_VERSION=            # optional override of the reported app version
DOURMOUSE_DESKTOP_NOTIFICATIONS=1 # 0 disables native alert notifications in the
                                  # desktop shell (SSE fan-out is still wired)

# ---------------------------------------------------------------------------
# Claude Code bridge — dev_coding subagent's claude_code tool + the v2.4
# code_claude coding agent. Optional: the tool auto-detects the 'claude' CLI
# on PATH; set this only to point at a specific binary.
# ---------------------------------------------------------------------------
CLAUDE_CODE_CLI=

# ---------------------------------------------------------------------------
# v2.4 — Multi-backend coding agents (code_nvidia / code_deepseek /
# code_claude). code_nvidia reuses NVIDIA_API_KEY above. code_deepseek uses
# the Freebuff free tier when FREEBUFF_DEEPSEEK_* are set, else plain
# DeepSeek, else (v5.1) routes through NVIDIA NIM using NVIDIA_API_KEY with
# DEEPSEEK_NVIDIA_MODEL below — so a single NVIDIA key powers DeepSeek too.
# code_claude uses the Claude Code CLI. All degrade honestly to
# NOT CONFIGURED when nothing is set. Consumed by dourmouse/code_backends.py.
# ---------------------------------------------------------------------------
FREEBUFF_DEEPSEEK_API_KEY=
FREEBUFF_DEEPSEEK_BASE_URL=
FREEBUFF_DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# v3.1 per-agent NVIDIA models (optional): give ONE subagent its own model
# (e.g. a coding-tuned model for dev_coding, a fast model for news). Any
# agent without an override runs on NVIDIA_MODEL above. Names are the roster
# agent names, uppercase: research_info, comms, scheduling, dev_coding,
# admin_ops, memory, system, news, markets, rnd, mail, tasks, messenger,
# code_nvidia, code_deepseek, code_claude, orchestrator.
# DOURMOUSE_MODEL_DEV_CODING=nvidia/code-llama-70b
# DOURMOUSE_MODEL_RESEARCH_INFO=nvidia/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# v4.0 — LOCAL LLM backend (the "fully free and local" win). Ollama is the
# primary brain; NVIDIA stays as a configured alternative. Consumed by
# dourmouse/config.py load_llm_config().
#   DOURMOUSE_LLM_BACKEND=ollama | nvidia | auto
#     auto (default): probe http://127.0.0.1:11434/api/tags — if Ollama is
#     live, use it; otherwise fall back to NVIDIA. Explicit settings skip
#     the probe and fail fast if the backend is unreachable.
# ---------------------------------------------------------------------------
DOURMOUSE_LLM_BACKEND=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b              # chat/reasoning model (installed locally)
# OLLAMA_CODING_MODEL=qwen2.5-coder:14b   # code_ollama uses this when set

# ---------------------------------------------------------------------------
# v4.0 — MULTI-DEVICE (Phase 9). Loopback (127.0.0.1) is always token-free so
# the desktop app and local chat never change; the token is enforced for any
# NON-loopback client. DOURMOUSE_HOST=0.0.0.0 exposes the dashboard to your
# LAN/tailnet — only do this AFTER setting a token. Consumed by
# dourmouse/config.py access_token() / bind_host().
# ---------------------------------------------------------------------------
DOURMOUSE_ACCESS_TOKEN=
DOURMOUSE_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# v4.0 — AUTOMATION (Phase 11). Time (24h, local) at which the DailyReporter
# posts the morning report to the bus. Consumed by dourmouse/report.py.
# ---------------------------------------------------------------------------
DOURMOUSE_REPORT_TIME=08:30

# ---------------------------------------------------------------------------
# v4.1 — VOICE (P7). FULLY local STT + TTS — zero cloud calls.
# Default OFF. Enable, install the optional wheels, then the HUD's [MIC]/[SPK]
# buttons go live. Consumed by dourmouse/voice.py.
#   pip install -r requirements-voice.txt   (faster-whisper + piper-tts)
# TTS works without piper on macOS (built-in 'say', zero deps); STT needs
# faster-whisper. First STT use downloads the model once, then it is local.
# ---------------------------------------------------------------------------
DOURMOUSE_VOICE=0
DOURMOUSE_WHISPER_MODEL=large-v3-turbo
DOURMOUSE_WHISPER_DEVICE=auto
DOURMOUSE_PIPER_VOICE=en_US-amy-medium

# ---------------------------------------------------------------------------
# v5.1 — Gmail tools (mail subagent: gmail_search / gmail_read / gmail_send).
# Either set the env vars below, OR — for a single-user install — fill in
# dourmouse/local_secrets.py (GMAIL_USER / GMAIL_APP_PASSWORD). That file is
# GITIGNORED so the credential never lands in git history or the dist zip;
# env vars always win when both are set. Get an App Password from Google
# account -> Security -> 2-Step Verification -> App passwords (NOT your
# login password). Consumed by dourmouse/google_services.py.
# ---------------------------------------------------------------------------
GOOGLE_GMAIL_USER=
GOOGLE_GMAIL_APP_PASSWORD=
# v5.24 — the display identity Dourmouse sends mail AS (FROM name). The FROM
# address is always the configured Gmail account; this only customizes the
# name recipients see. Defaults to "Dourmouse".
DOURMOUSE_EMAIL_NAME=
# v5.25 — Dourmouse's OWN mail identity. Without this, the own address is the
# +dourmouse receiving alias of the configured Gmail (you+dourmouse@gmail.com
# — mail to it lands in your inbox, no new account). Set a REAL dedicated
# address here once one exists (the browser agent can sign up for one).
DOURMOUSE_EMAIL_ADDRESS=
# v5.25 — dedicated SMTP mailbox: once Dourmouse has its own address on ANY
# provider, point these at it and email_own_send sends FROM the Dourmouse
# identity. Example (Gmail app-password SMTP as a +dourmouse alias after
# enabling 'Send mail as'):
#   DOURMOUSE_SMTP_HOST=smtp.gmail.com
#   DOURMOUSE_SMTP_PORT=465
#   DOURMOUSE_SMTP_USER=you@gmail.com
#   DOURMOUSE_SMTP_PASS=<app password>
#   DOURMOUSE_SMTP_FROM=you+dourmouse@gmail.com
#   DOURMOUSE_SMTP_TLS=1
DOURMOUSE_SMTP_HOST=
DOURMOUSE_SMTP_PORT=587
DOURMOUSE_SMTP_USER=
DOURMOUSE_SMTP_PASS=
DOURMOUSE_SMTP_FROM=
DOURMOUSE_SMTP_TLS=1
# v5.25 — browser agent (real headless Chrome via Playwright + the system
# Google Chrome). Headless by default; set 0 to WATCH the agent drive a
# visible Chrome window. The engine is pip-installed into the venv
# (playwright) — no browser download, it drives the installed Chrome.
DOURMOUSE_BROWSER_HEADLESS=1
# v5.26 — DOURMOUSE compute node (the Dell): a dedicated LAN inference
# server (Qwen3 1.7B on the Dell's own Ollama). The Dell is compute
# infrastructure, NOT a second DOURMOUSE — memory/integrations/orchestrator
# stay here. The main app probes it and falls back to the local AI
# automatically when it is offline. LAN ONLY — never port-forward it.
# v5.32 — DOURMOUSE_SERVER_ENABLED is the master kill switch: set 0 to
# hard-disable ALL Dell traffic (fast lane, tools, status, offload) with
# zero probes. Default ON; the real engagement gate is the URL being set.
DOURMOUSE_SERVER_ENABLED=1
DOURMOUSE_SERVER_URL=http://192.168.1.108:8000
DOURMOUSE_SERVER_API_KEY=
DOURMOUSE_SERVER_MODEL=qwen3:1.7b
# Generation/chat read timeout (seconds). The Dell is CPU-only and can take
# ~30s per short response — keep this comfortably above that.
DOURMOUSE_SERVER_TIMEOUT=90
# Health-probe CONNECT timeout (seconds): keep short so an absent node costs
# almost nothing per TTL window.
DOURMOUSE_SERVER_CONNECT_TIMEOUT=2
DOURMOUSE_SERVER_HEALTH_TTL=30
# v5.30 — route pure-chat fast-lane turns to the compute node when it is
# ONLINE (Qwen3 1.7B is smaller than the local fast model, so first token is
# faster and the M3 stays free), with automatic fallback to the local fast
# model on ANY failure. Only engages when DOURMOUSE_SERVER_URL is explicitly
# set AND a fresh cached probe says online — a sleeping Dell never adds
# probe latency to replies. Set 0 to keep the fast lane purely local.
DOURMOUSE_FAST_LANE_SERVER=1
# v5.15 — Google OAuth login: anyone signs in with their OWN Google account
# (login page shows a SIGN IN WITH GOOGLE button once both are set). Create a
# Web OAuth client in Google Cloud Console and register the callback URL(s):
#   http://127.0.0.1:8765/api/auth/google/callback   (loopback)
# plus your LAN/Tailscale host if you bind DOURMOUSE_HOST (https required for
# non-loopback unless you register the exact http redirect).
# The sign-in requests gmail.readonly, gmail.send, calendar.readonly,
# drive.readonly and drive.file (v5.29 — drive.file grants creating/editing
# Docs + Slides the app creates) — the consent screen lists them. v5.23:
# those are RESTRICTED scopes that Google 500s on an UNVERIFIED app, so
# sign-in now requests identity-only (openid/email/profile) by default and
# works immediately. Set GOOGLE_OAUTH_FULL_SCOPES=1 only once the app is
# verified (or in Testing mode with your account added as a test user) to
# restore Gmail/Calendar/Drive read + Drive write via OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# v5.23 — restricted-scope opt-in (see above). Leave empty on an unverified app.
GOOGLE_OAUTH_FULL_SCOPES=

# ---------------------------------------------------------------------------
# v5.3 — Codex CLI bridge (dev_coding's codex_code tool). Optional: the tool
# auto-detects the 'codex' CLI on PATH and uses the ChatGPT login it already
# has in ~/.codex/auth.json — no API key needed. CODEX_CLI points at a
# specific binary; CODEX_API_KEY powers the code_codex API backend instead.
# ---------------------------------------------------------------------------
CODEX_CLI=
CODEX_API_KEY=

# ---------------------------------------------------------------------------
# v5.3 — Freebuff Desktop integration (check_connections tool + the
# /api/connections endpoint). The app runs a local API (default port 51820)
# that requires a bearer token shown in the Freebuff app; paste it here to
# let Dourmouse read real Freebuff status. Without it, the tool honestly
# reports the app state + "token missing".
# ---------------------------------------------------------------------------
# v5.5: the Freebuff READ API is the app's own renderer server (51819,
# loopback, no token) — account/projects/threads/notes/skills are read live
# when the Freebuff app is running + signed in. The old 51820 bridge needs a
# per-launch random token (regenerates every app start) and is the app's
# internal debugger API — it is NOT the read path and needs no token here.
FREEBUFF_API_URL=http://127.0.0.1:51819
FREEBUFF_API_TOKEN=

# ---------------------------------------------------------------------------
# v5.3 — per-agent OLLAMA models (mirror of the NVIDIA DOURMOUSE_MODEL_<AGENT>
# convention). CAUTION: the per-agent override is ALSO the dispatch BRAIN for
# that agent's runs, so it must be tool-calling-capable. Measured live:
# qwen2.5:7b (the default brain) calls tools correctly; qwen2.5-coder:14b
# answers WITHOUT calling any tool. Only override with a model that emits
# tool calls (e.g. qwen3:8b).
# ---------------------------------------------------------------------------
# DOURMOUSE_OLLAMA_MODEL_DEV_CODING=qwen3:8b

# ---------------------------------------------------------------------------
# v5.6 — Neural orchestrator (learns orchestration from outcomes).
# A real pure-numpy MLP learns TWO orchestration decisions from real runs:
# (a) which requests are multi-step (plan + heavy brain), and (b) which
# subagent should own each request — trained self-supervised from the agents
# actually used, weighted by run quality and your 👍/👎 ratings. It BLENDS
# with the deterministic heuristics (never replaces them: its max routing
# boost sits below the tool-mention/domain/name bonuses), and stays inactive
# until it has >= 25 experiences and trained weights — zero regression before
# that. Experiences + weights live in <workspace>/neuro/.
# DOURMOUSE_NET=0 disables it entirely (back to pure heuristics).
# DOURMOUSE_NET_DIR overrides the store location (tests use a tmp dir).
# ---------------------------------------------------------------------------
DOURMOUSE_NET=1
DOURMOUSE_NET_DIR=

# ---------------------------------------------------------------------------
# v5.7 — Spotify (music agent). PKCE OAuth2: only a Client ID is needed (no
# client secret). Get it free at developer.spotify.com -> create an app, add
# the redirect URI http://127.0.0.1:8766/callback to the app's Redirect URIs,
# then either set SPOTIFY_CLIENT_ID here (shared/multi-device) or fill
# SPOTIFY_CLIENT_ID in dourmouse/local_secrets.py (single user). Link once
# via the music agent's spotify_link tool, the HUD [LOGIN] button, or
# 'python -m dourmouse.spotify_services --login'. Refresh tokens never
# expire on Spotify, so linking is one-time.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_PORT=8766
