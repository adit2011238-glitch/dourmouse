+[data-screen="RESEARCH"] .rs-jobpause { display: block; margin-top: 6px; }
+[data-screen="RESEARCH"] .rs-brief { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 320px; overflow: auto; margin: 0; font: inherit; }
+[data-screen="RESEARCH"] .rs-notes { width: 100%; box-sizing: border-box; font: inherit; }
+[data-screen="RESEARCH"] .rs-job input[type="text"] { width: 100%; box-sizing: border-box; }
+[data-screen="RESEARCH"] .rs-subq { margin: 0; padding-left: 18px; }
+[data-screen="RESEARCH"] .rs-steps { margin: 0; padding-left: 18px; }
+[data-screen="RESEARCH"] .rs-card summary { cursor: pointer; overflow-wrap: anywhere; }
+[data-screen="RESEARCH"] .rs-card { display: grid; gap: 4px; }
+[data-screen="RESEARCH"] .rs-finding blockquote { margin: 2px 0 0 12px; overflow-wrap: anywhere; }
+[data-screen="RESEARCH"] .rs-answer p { margin: 4px 0; }
+[data-screen="RESEARCH"] .rs-ref { margin: 2px 0; overflow-wrap: anywhere; }
